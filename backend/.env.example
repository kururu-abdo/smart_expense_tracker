ENVIRONMENT=development
DATABASE_URL=sqlite:///./masar.db
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-unique-secret-before-running
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
# Secret server key with access to GET /v1/subscribers. Never include it in Flutter.
REVENUECAT_SECRET_KEY=
# Set the exact same Authorization header value in RevenueCat's webhook integration.
REVENUECAT_WEBHOOK_AUTHORIZATION=
REVENUECAT_SIGNING_SECRET=
REVENUECAT_ENTITLEMENT=premium
REVENUECAT_ALLOW_SANDBOX=false
